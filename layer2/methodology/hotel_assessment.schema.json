{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "hotel_id",
    "evidence_review_count",
    "date_range",
    "positive_breadth",
    "positive_themes",
    "concern_themes",
    "positive_evidence",
    "concern_evidence",
    "max_supported_severity",
    "max_stay_impact",
    "recurrence_level",
    "temporal_status",
    "resolution_status",
    "property_relevance_status",
    "operational_consistency",
    "evidence_cautions",
    "confidence",
    "confidence_reason",
    "band",
    "band_label",
    "band_position",
    "headline",
    "summary",
    "what_to_verify",
    "material_evidence_ids",
    "limitations",
    "claim_boundary_statement"
  ],
  "properties": {
    "hotel_id": {
      "type": "string"
    },
    "evidence_review_count": {
      "type": "integer",
      "minimum": 1
    },
    "date_range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "start",
        "end"
      ],
      "properties": {
        "start": {
          "type": "string"
        },
        "end": {
          "type": "string"
        }
      }
    },
    "positive_breadth": {
      "type": "string",
      "enum": [
        "narrow",
        "moderate",
        "broad",
        "very_broad"
      ]
    },
    "positive_themes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "concern_themes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "positive_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "theme",
          "review_ids"
        ],
        "properties": {
          "theme": {
            "type": "string"
          },
          "review_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        }
      }
    },
    "concern_evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "theme",
          "severity",
          "impact",
          "recurrence",
          "resolution",
          "review_ids"
        ],
        "properties": {
          "theme": {
            "type": "string"
          },
          "severity": {
            "type": "string",
            "enum": [
              "S1",
              "S2",
              "S3",
              "S4"
            ]
          },
          "impact": {
            "type": "string",
            "enum": [
              "I0",
              "I1",
              "I2",
              "I3"
            ]
          },
          "recurrence": {
            "type": "string",
            "enum": [
              "C0",
              "C1",
              "C2",
              "C3"
            ]
          },
          "resolution": {
            "type": "string",
            "enum": [
              "Resolved",
              "Partly resolved",
              "Unresolved",
              "Unknown"
            ]
          },
          "review_ids": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          }
        }
      }
    },
    "max_supported_severity": {
      "type": "string",
      "enum": [
        "S0",
        "S1",
        "S2",
        "S3",
        "S4"
      ]
    },
    "max_stay_impact": {
      "type": "string",
      "enum": [
        "I0",
        "I1",
        "I2",
        "I3"
      ]
    },
    "recurrence_level": {
      "type": "string",
      "enum": [
        "C0",
        "C1",
        "C2",
        "C3"
      ]
    },
    "temporal_status": {
      "type": "string",
      "enum": [
        "improving",
        "stable_positive",
        "mixed",
        "stable_concern",
        "worsening",
        "insufficient_recent_evidence"
      ]
    },
    "resolution_status": {
      "type": "string",
      "enum": [
        "Resolved",
        "Partly resolved",
        "Unresolved",
        "Unknown"
      ]
    },
    "property_relevance_status": {
      "type": "string",
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3"
      ]
    },
    "operational_consistency": {
      "type": "string",
      "enum": [
        "high_consistency",
        "moderate_consistency",
        "high_variability",
        "insufficient_evidence"
      ]
    },
    "evidence_cautions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "confidence": {
      "type": "string",
      "enum": [
        "High",
        "Medium-high",
        "Medium",
        "Low-medium",
        "Low"
      ]
    },
    "confidence_reason": {
      "type": "string"
    },
    "band": {
      "type": "string",
      "enum": [
        "A",
        "B",
        "C",
        "D",
        "E",
        "F",
        "G",
        "H"
      ]
    },
    "band_label": {
      "type": "string",
      "enum": [
        "Exceptional evidence pattern",
        "Strong evidence pattern",
        "Generally positive with meaningful limitations",
        "Mixed or conditional evidence",
        "Weak, high-variance or reliability-concern evidence",
        "Recurring serious concern",
        "Persistent severe concern",
        "Critical failure pattern"
      ]
    },
    "band_position": {
      "type": "string",
      "enum": [
        "upper",
        "middle",
        "lower"
      ]
    },
    "headline": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "what_to_verify": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "material_evidence_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "claim_boundary_statement": {
      "type": "string"
    }
  }
}