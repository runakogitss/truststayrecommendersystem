  "properties": {
    "schema_version": {"type": "string"}, "dataset_namespace": {"const": "HOTELREC"}, "hotel_id": {"type": "string"}, "hotel_metadata": {"type": "object"}, "temporal_summaries": {"type": "object"}, "semantic_clusters": {"type": "array"}, "absa_evidence": {"type": "object"}, "review_evidence_records": {"type": "array"}, "provenance": {"type": "object"}, "methodology_notes": {"type": "object"}, "warnings": {"type": "array", "items": {"type": "string"}}
  }
}
